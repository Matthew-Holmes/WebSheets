{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LLM": {
    "DeepSeekAPIKeyFile": "run/secrets/DeepSeekAPIKey.txt"
  },
  "ContentRepository": {
    "CloneUrl": "https://github.com/Matthew-Holmes/Matthews_Mathematics",
    "PushUrl": "git@github.com:Matthew-Holmes/Matthews_Mathematics.git",
    "LocalDirectory": "Matthews_Mathematics",
    "SourceDirectory": "latex",
    "SshKeyPath": "/root/.ssh/id_ed25519"
  },
  "Generation": {
    "MaxFilesPerRun": 10
  },
  "L2": {
    "Colours": {
      "Tier3": { "R": 0, "G": 128, "B": 0, "Name": "green" },
      "English": { "R": 0, "G": 0, "B": 0, "Name": "black" },
      "Translation": { "R": 112, "G": 48, "B": 160, "Name": "purple" }
    },
    "Languages": {
      "pol": { "Font": "Noto Serif", "BabelName": "polish", "RightToLeft": false },
      "urd": { "Font": "Noto Nastaliq Urdu", "BabelName": "urdu", "RightToLeft": true },
      "pan": { "Font": "Noto Sans Gurmukhi", "BabelName": "punjabi", "RightToLeft": false },
      "ben": { "Font": "Noto Sans Bengali", "BabelName": "bengali", "RightToLeft": false },
      "ara": { "Font": "Noto Naskh Arabic", "BabelName": "arabic", "RightToLeft": true }
    },
    "EagerLanguages": [ "pol", "urd", "pan", "ben", "ara" ],
    "Glossary": {
      "numerator": "the number above the line in a fraction",
      "denominator": "the number below the line in a fraction",
      "product": "the answer when two numbers are multiplied",
      "sum": "the answer when numbers are added together",
      "difference": "the answer when one number is subtracted from another",
      "perimeter": "the total distance around the edge of a shape",
      "area": "the amount of space inside a flat shape",
      "simplify": "write something in its smallest or simplest form"
    }
  },
  "Api": {
    "Port": 5432
  },
  "AllowedHosts": "*"
}
