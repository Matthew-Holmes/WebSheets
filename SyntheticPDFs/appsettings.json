{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LLM": {
    "DeepSeekAPIKeyFile": "run/secrets/DeepSeekAPIKey.txt"
  },
  "ContentRepository": {
    "CloneUrl": "https://github.com/Matthew-Holmes/Matthews_Mathematics",
    "PushUrl": "git@github.com:Matthew-Holmes/Matthews_Mathematics.git",
    "LocalDirectory": "Matthews_Mathematics",
    "SourceDirectory": "latex",
    "SshKeyPath": "/root/.ssh/id_ed25519",
    "DictionaryPath": "latex/dictionary/mathematicalDictionary.tex"
  },
  "Generation": {
    "MaxFilesPerRun": 10
  },
  "L2": {
    "GenerateVocabularyKeys": true,
    "Colours": {
      "Tier3": {
        "R": 0,
        "G": 128,
        "B": 0,
        "Name": "green"
      },
      "English": {
        "R": 0,
        "G": 0,
        "B": 0,
        "Name": "black"
      },
      "Translation": {
        "R": 112,
        "G": 48,
        "B": 160,
        "Name": "purple"
      }
    },
    "Languages": {
      "pol": {
        "Font": "Noto Serif",
        "BabelName": "polish",
        "RightToLeft": false
      },
      "urd": {
        "Font": "Noto Nastaliq Urdu",
        "BabelName": "urdu",
        "RightToLeft": true
      },
      "pan": {
        "Font": "Noto Sans Gurmukhi",
        "BabelName": "punjabi",
        "RightToLeft": false
      },
      "ben": {
        "Font": "Noto Sans Bengali",
        "BabelName": "bengali",
        "RightToLeft": false
      },
      "ara": {
        "Font": "Noto Naskh Arabic",
        "BabelName": "arabic",
        "RightToLeft": true
      }
    },
    "EagerLanguages": [
      "pol",
      "urd",
      "pan",
      "ben",
      "ara"
    ]
  },
  "Api": {
    "Port": 5432
  },
  "AllowedHosts": "*"
}
