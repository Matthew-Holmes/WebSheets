# Goes to /etc/mattsmaths/mmWebsite.env on the droplet, root owned, mode 600.
# The values below are placeholders - the real ones are never committed.

# What callers must present in X-WebSheets-Trigger-Key to start a generation run.
SyntheticPdfsTrigger__ApiKey=<random hex string>

# The ObjectStoreCredentials__ entries this file used to carry are no longer
# read by anything: the site takes the manifest and the PDFs from the public
# files.matthewsmathematics.uk endpoint, which needs no credentials. They can go.
