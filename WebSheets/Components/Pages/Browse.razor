@page "/browse"
@page "/browse/{*Path}"

@using WebSheets.Models

<PageTitle>Browse</PageTitle>

<h3>@(CurrentPath == "" ? "Browse" : CurrentPath)</h3>

@if (Node == null)
{
    <p>Loading...</p>
}
else
{
    @if (Node.Parent != null)
    {
        <p>
            <a href="@ParentDirLink()">⬅️ Back</a>
        </p>
    }

    <ul class="listing">
        @foreach (var folder in Folders)
        {
            <li class="folder">
                <a href="@DirLink(folder.Name)">📁 @folder.Name</a>
            </li>
        }

        @foreach (var dictionary in Dictionaries)
        {
            <li class="sheet">
                <div class="sheet-row">
                    <a class="sheet-link" href="@FileLink(dictionary)" target="_blank">
                        📖 @DictionaryTitle(dictionary)
                    </a>
                    <span class="source-after"> - <a href="@SourceLink(dictionary)" target="_blank">source</a></span>
                </div>
            </li>
        }

        @foreach (var group in Groups)
        {
            // the sheet itself laid out to be printed and handed out. it is a version of
            // the sheet on this line rather than something derived from it, so it branches
            // off the menu the sheet's own row opens
            var printable = group.PrintableVersionOf(SheetPart.Sheet, SheetForm.Original);

            var variants = group.VariantsInOrder().ToList();

            <li class="sheet">
                <div class="sheet-row">
                    @if (group.Sheet is not null)
                    {
                        <a class="sheet-link" href="@FileLink(group.Sheet)" target="_blank">
                            📄 @group.RootName
                        </a>
                    }
                    else
                    {
                        @* derived files whose sheet has gone - still worth seeing *@
                        <span class="sheet-link missing">📄 @group.RootName</span>
                    }

                    @if (group.HasAnythingBeyondTheSheet || group.Sheet is not null)
                    {
                        <span class="menu-hint" aria-hidden="true">▾</span>

                        <ul class="menu">
                            @if (printable is not null)
                            {
                                <li class="has-submenu">
                                    <a href="@FileLink(printable)" target="_blank">
                                        🖨️ @WorksheetNaming.PrintableName
                                    </a>
                                    <span class="submenu-hint" aria-hidden="true">›</span>
                                    <ul class="submenu">
                                        <li><a href="@SourceLink(printable)" target="_blank">source</a></li>
                                    </ul>
                                </li>
                            }

                            @foreach (var part in new[] { SheetPart.WorkedSolutions, SheetPart.Solutions })
                            {
                                var file = group.Parts.GetValueOrDefault(part);

                                @if (file is not null)
                                {
                                    <li class="has-submenu">
                                        <a href="@FileLink(file)" target="_blank">
                                            @WorksheetNaming.Describe(part, SheetForm.Original)
                                        </a>
                                        <span class="submenu-hint" aria-hidden="true">›</span>
                                        <ul class="submenu">
                                            <li><a href="@SourceLink(file)" target="_blank">source</a></li>
                                        </ul>
                                    </li>
                                }
                            }

                            @if (group.Glossary is not null)
                            {
                                <li class="has-submenu">
                                    <a href="@FileLink(group.Glossary)" target="_blank">glossary</a>
                                    <span class="submenu-hint" aria-hidden="true">›</span>
                                    <ul class="submenu">
                                        <li><a href="@SourceLink(group.Glossary)" target="_blank">source</a></li>
                                    </ul>
                                </li>
                            }

                            @* only when there is something above it to separate from *@
                            @if (group.WorkedSolutions is not null || group.Solutions is not null
                                 || group.Glossary is not null || printable is not null)
                            {
                                <li class="menu-separator"></li>
                            }

                            <li>
                                <a href="@EalLink(group)">
                                    🌍 for EAL learners
                                    @if (group.Translations.Count > 0)
                                    {
                                        <span class="count">@group.Translations.Count</span>
                                    }
                                </a>
                            </li>

                            @* the same sheet worded differently, for a school that asks
                               for it that way. its own section, since it is neither a
                               part of the sheet nor a translation of it *@
                            @if (variants.Count > 0)
                            {
                                <li class="menu-separator"></li>
                                <li class="menu-heading">variants</li>

                                @foreach (var (part, form, file) in variants)
                                {
                                    var variantPrintable = group.PrintableVersionOf(part, form);

                                    <li class="has-submenu">
                                        <a href="@FileLink(file)" target="_blank">
                                            @WorksheetNaming.VariantName(part, form)
                                        </a>
                                        <span class="submenu-hint" aria-hidden="true">›</span>
                                        <ul class="submenu">
                                            @* the printable version of this variant hangs
                                               off the variant, for the same reason the
                                               sheet's hangs off the sheet *@
                                            @if (variantPrintable is not null)
                                            {
                                                <li class="has-submenu">
                                                    <a href="@FileLink(variantPrintable)" target="_blank">
                                                        🖨️ @WorksheetNaming.PrintableName
                                                    </a>
                                                    <span class="submenu-hint" aria-hidden="true">›</span>
                                                    <ul class="submenu">
                                                        <li><a href="@SourceLink(variantPrintable)" target="_blank">source</a></li>
                                                    </ul>
                                                </li>
                                            }
                                            <li><a href="@SourceLink(file)" target="_blank">source</a></li>
                                        </ul>
                                    </li>
                                }
                            }
                        </ul>
                    }

                    @* the sheet's own source stays on the line, as it always was - the
                       menu is for the files derived from it *@
                    @if (group.Sheet is not null)
                    {
                        <span class="source-after"> - <a href="@SourceLink(group.Sheet)" target="_blank">source</a></span>
                    }
                </div>
            </li>
        }
    </ul>

    @if (Folders.Count == 0 && Groups.Count == 0 && Dictionaries.Count == 0)
    {
        <p>Nothing here.</p>
    }
}
